# Mokara API — required environment (copy to .env, fill in, never commit .env)

# Database (local dev: Homebrew PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=btc_simulator_local
POSTGRES_USER=your-system-user
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Shared secret between the Next.js BFF and this API (generate: openssl rand -hex 32)
INTERNAL_API_SECRET=

# Gemini (AI strategy generation / analysis; GEMINI_MODEL_FAST also drives
# simulation-report AI analysis in api/reporting/analysis.py)
GEMINI_API_KEY=
# Model overrides. Keys created after ~2026 can't call gemini-2.5-pro (404,
# "no longer available to new users") — set the strong tier to a 3.x model.
# gemini-2.0-flash was fully retired 2026-09 (404 for all callers); the fast
# tier's default was bumped to gemini-2.5-flash accordingly.
# GEMINI_MODEL_STRONG=gemini-3.1-pro-preview
# GEMINI_MODEL_FAST=gemini-2.5-flash

# Admin (system reset double-check)
ADMIN_PASSWORD=

# PDF storage: local (default) or gcs
# PDF_STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=
