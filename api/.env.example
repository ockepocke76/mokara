# Mokara API — required environment (copy to .env, fill in, never commit .env)

# Database (local dev: Homebrew PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=btc_simulator_local
POSTGRES_USER=your-system-user
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Shared secret between the Next.js BFF and this API (generate: openssl rand -hex 32)
INTERNAL_API_SECRET=

# Gemini (AI strategy generation / analysis; GEMINI_MODEL_FAST also drives
# simulation-report AI analysis in api/reporting/analysis.py)
GEMINI_API_KEY=
# Model overrides. Keys created after ~2026 can't call gemini-2.5-pro (404,
# "no longer available to new users"), so the strong tier now defaults to
# gemini-3.8-flash (GA, Google's current best model for coding/agent work) —
# cheaper than the gemini-3.1-pro-preview alternative and scores higher on
# coding benchmarks. Override to gemini-3.1-pro-preview for reasoning-heavy
# tasks that need Pro-tier abstract reasoning instead.
# gemini-2.0-flash was fully retired 2026-09 (404 for all callers); the fast
# tier's default was bumped to gemini-2.5-flash accordingly, but 2.5-flash is
# itself scheduled for deprecation 2026-10-16, so the fast tier now defaults
# to gemini-3.5-flash-lite (GA, no shutdown date announced as of 2026-09-18) —
# a Flash-Lite tier fits these lightweight spec/clarify/review calls better
# on price than matching the strong tier's Flash model. Avoid
# gemini-3.1-flash-lite: it already has an announced shutdown (2027-05-07)
# recommending gemini-3.5-flash-lite as the replacement, so it's not a
# forward-looking pick.
# Every call is costed into LLM_USAGE (see /admin/llm-usage) from the price
# table in core/llm_pricing.py — overriding to a model not listed there
# records cost NULL ("unpriced"); add the entry. Note the strong tier is
# ~90% of a strategy run's cost and gemini-3.1-pro-preview is ~3x the
# default's price (LLM_COST_MODEL.md).
# GEMINI_MODEL_STRONG=gemini-3.1-pro-preview
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Admin (system reset double-check)
ADMIN_PASSWORD=

# PDF storage: local (default) or gcs
# PDF_STORAGE_BACKEND=gcs
# GCS_BUCKET_NAME=
