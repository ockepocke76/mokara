# Mokara web — required environment (copy to .env, fill in, never commit .env)

# FastAPI backend (BFF target)
API_URL=http://localhost:8000
# Must match INTERNAL_API_SECRET in api/.env
INTERNAL_API_SECRET=

# Better Auth (W1)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local dev only: email+password login form (no Google needed).
# Ignored in production builds (NODE_ENV=production) — the sign-up flow is
# unverified, so it must never run against a real user table.
AUTH_DEV_LOGIN=1

# Postgres (Better Auth session/user tables — same DB as the engine)
DATABASE_URL=postgresql://localhost:5432/btc_simulator_local
